# Default: private local vLLM server
MODEL_PROVIDER=local
VLLM_BASE_URL=http://localhost:9000/v1
MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct

# Opt in to one hosted provider. API keys belong only in this server's process
# environment or a local, git-ignored .env file — never in the extension.
# MODEL_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_MODEL=gpt-5-mini

# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=replace_me
# GEMINI_MODEL=gemini-2.5-flash

MAX_RESPONSE_TOKENS=1024
TEMPERATURE=0.1

# Input budget applied identically to local and hosted providers.
MAX_INTERACTIVE_ELEMENTS=16
MAX_VISIBLE_TEXT_CHARS=800
MAX_IMAGE_SIDE_PX=1024
IMAGE_JPEG_QUALITY=75
