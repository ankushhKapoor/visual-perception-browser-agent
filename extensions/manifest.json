{
  "manifest_version": 3,
  "name": "Visual Perception Browser Agent",
  "version": "0.1.0",
  "description": "Privacy-preserving browser vision agent for SIH26171",

  "permissions": [
    "activeTab"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "extensions/src/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extensions/src/content.js"
      ]
    }
  ],

  "action": {
    "default_title": "Visual Perception Agent"
  }
}