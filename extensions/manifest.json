{
  "manifest_version": 3,
  "name": "Visual Perception Browser Agent",
  "version": "0.2.0",
  "description": "Privacy-preserving visual browser agent powered by VLM (SIH26171)",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "extensions/src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file:///*"
      ],
      "js": [
        "extensions/src/chatbot.js",
        "extensions/src/executor.js",
        "extensions/src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Visual Perception Agent",
    "default_popup": "extensions/public/popup.html"
  }
}